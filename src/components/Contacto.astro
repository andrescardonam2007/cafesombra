---
// Order form: client-side validation with inline errors and a simulated
// confirmation in an aria-live region. No network calls.
import { productos } from '../data/productos';

const formatoPrecio = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
  maximumFractionDigits: 0,
});
---

<section id="pedido" class="pedido" tabindex="-1">
  <h2 class="pedido-titulo">Hagamos tu pedido</h2>
  <p class="pedido-intro">
    Elige el grano y la cantidad. Te escribimos al correo con los detalles de la
    entrega en Jardín o del envío a todo el país.
  </p>

  <form id="form-pedido" class="pedido-form" novalidate>
    <div class="campo">
      <label for="nombre">Nombre</label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        autocomplete="name"
        required
        aria-describedby="error-nombre"
      />
      <p id="error-nombre" class="campo-error" hidden></p>
    </div>

    <div class="campo">
      <label for="correo">Correo</label>
      <input
        id="correo"
        name="correo"
        type="email"
        autocomplete="email"
        required
        aria-describedby="error-correo"
      />
      <p id="error-correo" class="campo-error" hidden></p>
    </div>

    <div class="campo">
      <label for="producto">Producto</label>
      <select id="producto" name="producto" required aria-describedby="error-producto">
        <option value="" selected>Elige un grano…</option>
        {productos.map((producto) => (
          <option value={producto.id}>
            {producto.nombre} ({producto.peso}) · {formatoPrecio.format(producto.precio)}
          </option>
        ))}
      </select>
      <p id="error-producto" class="campo-error" hidden></p>
    </div>

    <div class="campo">
      <label for="cantidad">Cantidad</label>
      <input
        id="cantidad"
        name="cantidad"
        type="number"
        min="1"
        step="1"
        inputmode="numeric"
        required
        aria-describedby="error-cantidad"
      />
      <p id="error-cantidad" class="campo-error" hidden></p>
    </div>

    <div class="campo">
      <label for="mensaje">Mensaje (opcional)</label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="3"
        aria-describedby="error-mensaje"
      ></textarea>
      <p id="error-mensaje" class="campo-error" hidden></p>
    </div>

    <button class="pedido-enviar" type="submit">Confirmar pedido</button>
  </form>

  <p id="confirmacion" class="confirmacion" role="status" aria-live="polite" hidden></p>
</section>

<script>
  const formulario = document.getElementById('form-pedido') as HTMLFormElement;
  const confirmacion = document.getElementById('confirmacion') as HTMLElement;

  const campos: Record<
    string,
    { control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement; error: HTMLElement }
  > = {
    nombre: {
      control: document.getElementById('nombre') as HTMLInputElement,
      error: document.getElementById('error-nombre') as HTMLElement,
    },
    correo: {
      control: document.getElementById('correo') as HTMLInputElement,
      error: document.getElementById('error-correo') as HTMLElement,
    },
    producto: {
      control: document.getElementById('producto') as HTMLSelectElement,
      error: document.getElementById('error-producto') as HTMLElement,
    },
    cantidad: {
      control: document.getElementById('cantidad') as HTMLInputElement,
      error: document.getElementById('error-cantidad') as HTMLElement,
    },
    mensaje: {
      control: document.getElementById('mensaje') as HTMLTextAreaElement,
      error: document.getElementById('error-mensaje') as HTMLElement,
    },
  };

  function marcarError(
    campo: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    error: HTMLElement,
    mensaje: string
  ): void {
    error.textContent = mensaje;
    error.hidden = false;
    campo.setAttribute('aria-invalid', 'true');
  }

  function limpiarError(
    campo: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    error: HTMLElement
  ): void {
    error.textContent = '';
    error.hidden = true;
    campo.removeAttribute('aria-invalid');
  }

  const patronCorreo = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function validar(): boolean {
    let valido = true;
    let primerInvalido: HTMLElement | null = null;

    const nombre = campos.nombre.control as HTMLInputElement;
    const correo = campos.correo.control as HTMLInputElement;
    const producto = campos.producto.control as HTMLSelectElement;
    const cantidad = campos.cantidad.control as HTMLInputElement;

    if (nombre.value.trim() === '') {
      marcarError(nombre, campos.nombre.error, 'Escribe tu nombre para el pedido.');
      valido = false;
      if (!primerInvalido) primerInvalido = nombre;
    } else {
      limpiarError(nombre, campos.nombre.error);
    }

    const valorCorreo = correo.value.trim();
    if (valorCorreo === '') {
      marcarError(correo, campos.correo.error, 'Escribe tu correo para recibir la confirmación.');
      valido = false;
      if (!primerInvalido) primerInvalido = correo;
    } else if (!patronCorreo.test(valorCorreo)) {
      marcarError(
        correo,
        campos.correo.error,
        'Ese correo no parece válido. Revisa la dirección, por ejemplo nombre@dominio.com.'
      );
      valido = false;
      if (!primerInvalido) primerInvalido = correo;
    } else {
      limpiarError(correo, campos.correo.error);
    }

    if (producto.value === '') {
      marcarError(producto, campos.producto.error, 'Elige un grano del catálogo.');
      valido = false;
      if (!primerInvalido) primerInvalido = producto;
    } else {
      limpiarError(producto, campos.producto.error);
    }

    const valorCantidad = cantidad.value.trim();
    if (valorCantidad === '') {
      marcarError(cantidad, campos.cantidad.error, 'Escribe cuántas unidades quieres.');
      valido = false;
      if (!primerInvalido) primerInvalido = cantidad;
    } else {
      const numero = Number(valorCantidad);
      if (!Number.isInteger(numero) || numero < 1) {
        marcarError(cantidad, campos.cantidad.error, 'La cantidad debe ser un número entero desde 1.');
        valido = false;
        if (!primerInvalido) primerInvalido = cantidad;
      } else {
        limpiarError(cantidad, campos.cantidad.error);
      }
    }

    if (primerInvalido) primerInvalido.focus();
    return valido;
  }

  formulario.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!validar()) return;

    const nombre = campos.nombre.control as HTMLInputElement;
    const correo = campos.correo.control as HTMLInputElement;
    const producto = campos.producto.control as HTMLSelectElement;
    const cantidad = campos.cantidad.control as HTMLInputElement;

    const opcion = producto.selectedOptions[0];
    const grano = opcion ? opcion.textContent : 'tu grano';
    confirmacion.textContent = `Gracias, ${nombre.value.trim()}. Recibimos tu pedido de ${cantidad.value.trim()} ${grano}. Te escribiremos a ${correo.value.trim()} con los detalles de la entrega.`;
    confirmacion.hidden = false;

    formulario.reset();
    for (const campo of Object.values(campos)) {
      limpiarError(campo.control, campo.error);
    }
  });
</script>

<style>
  .pedido {
    max-width: 34rem;
    margin-inline: auto;
    padding: 4rem 1.25rem;
  }

  .pedido:focus {
    outline: none;
  }

  .pedido-titulo {
    font-size: clamp(1.75rem, 3vw + 0.75rem, 2.5rem);
    margin: 0;
  }

  .pedido-intro {
    margin: 0.5rem 0 2rem;
  }

  .pedido-form {
    display: grid;
    gap: 1.25rem;
  }

  .campo {
    display: grid;
    gap: 0.375rem;
  }

  .campo label {
    font-weight: 600;
  }

  .campo input,
  .campo select,
  .campo textarea {
    background-color: var(--color-flor);
    border: 1px solid var(--color-pulpa);
    border-radius: 6px;
    color: var(--color-bosque);
    font: inherit;
    padding: 0.625rem 0.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .campo textarea {
    resize: vertical;
  }

  .campo input:focus,
  .campo select:focus,
  .campo textarea:focus {
    border-color: var(--color-yema);
  }

  .campo input[aria-invalid='true'],
  .campo select[aria-invalid='true'],
  .campo textarea[aria-invalid='true'] {
    border-color: var(--color-cereza);
  }

  .campo-error {
    margin: 0;
    color: var(--color-cereza);
    font-size: 0.9rem;
  }

  .pedido-enviar {
    background-color: var(--color-yema);
    border: none;
    border-radius: 6px;
    color: var(--color-bosque);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    justify-self: start;
    margin-block-start: 0.5rem;
  }

  .pedido-enviar:hover {
    background-color: color-mix(in srgb, var(--color-yema) 88%, var(--color-bosque));
  }

  .confirmacion {
    background-color: var(--color-flor);
    border: 1px solid var(--color-pulpa);
    border-inline-start-width: 4px;
    border-radius: 6px;
    margin-block-start: 2rem;
    padding: 1rem 1.25rem;
  }
</style>