---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Catalogo from '../components/Catalogo.astro';
import Origen from '../components/Origen.astro';
import Contacto from '../components/Contacto.astro';
---

<Base>
  <Nav />
  <main id="contenido">
    <Hero />
    <Catalogo />
    <Origen />
    <Contacto />
  </main>
  <footer class="pie">
    <p>Oropéndola — Café de Origen · Finca La Esperanza, Jardín (Antioquia)</p>
    <p>Cada taza es un bosque que se oye.</p>
  </footer>
</Base>

<style>
  .pie {
    border-block-start: 1px solid var(--color-pulpa);
    margin-inline: auto;
    max-width: 72rem;
    padding: 2rem 1.25rem 3rem;
    text-align: center;
  }

  .pie p {
    margin: 0;
  }

  .pie p + p {
    margin-block-start: 0.25rem;
  }
</style>